{
  "name": "code-project-tracker",
  "displayName": "Code Project Tracker",
  "description": "Tracks bugs, tasks, and code metrics inside your workspace",
  "version": "1.0.0",
  "publisher": "clarissa-dev-codes",
  "repository": {
    "type": "git",
    "url": "https://github.com/clarissa-dev-codes/code-project-tracker"
  },
  "icon": "media/icon-store.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "project-tracker-sidebar",
          "title": "Project Tracker",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "project-tracker-sidebar": [
        {
          "type": "webview",
          "id": "code-project-tracker.sidebarView",
          "name": "Workspace Project Management",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "code-project-tracker.openTracker",
        "title": "Open Full Dashboard (Main Editor)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "typescript-eslint": "^8.18.0",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
